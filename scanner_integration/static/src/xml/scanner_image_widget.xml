<?xml version="1.0" encoding="UTF-8"?>
<templates xml:space="preserve">

<!-- ═══════════════════════════════════════════════════════════════════════
     SHARED SUB-TEMPLATES
════════════════════════════════════════════════════════════════════════ -->

    <t t-name="scanner_integration.CropEditor">
        <div class="o_scn_editor border rounded overflow-hidden shadow o_scn_dark">

            <div class="o_scn_bar o_scn_bar_top d-flex align-items-center justify-content-between gap-2 px-3 py-2">
                <span class="fw-semibold">
                    <i class="fa fa-crop me-1 text-primary"/>
                    <t t-if="chequeMode">Adjust Crop Area</t>
                    <t t-elif="state.cropPageIdx === -1">Crop New Page</t>
                    <t t-else="">Crop — Page <t t-esc="state.cropPageIdx + 1"/></t>
                </span>
                <span class="d-flex align-items-center gap-3">
                    <small t-if="state.cropInfo" class="o_scn_accent">
                        <i class="fa fa-magic me-1"/><t t-esc="state.cropInfo"/>
                    </small>
                    <small t-if="state.cropReady and cropDimensionsLabel" class="o_scn_dim font-monospace">
                        <i class="fa fa-arrows-alt me-1"/><t t-esc="cropDimensionsLabel"/>
                    </small>
                    <small class="o_scn_muted d-none d-lg-inline">Drag the box to move · drag the handles to resize</small>
                </span>
            </div>

            <div class="o_scn_stage overflow-auto">
                <div class="o_scn_stage_inner">
                    <img t-ref="cropImage"
                         t-att-src="rawImageSrc"
                         class="o_scn_crop_img"
                         draggable="false"
                         alt="Scan"
                         t-on-load="onCropImageLoad"
                         t-on-error="onCropImageError"/>

                    <t t-if="state.cropReady">
                        <div class="o_scn_shade" t-att-style="cropStyles.overlayTop"/>
                        <div class="o_scn_shade" t-att-style="cropStyles.overlayBottom"/>
                        <div class="o_scn_shade" t-att-style="cropStyles.overlayLeft"/>
                        <div class="o_scn_shade" t-att-style="cropStyles.overlayRight"/>

                        <div class="o_scn_crop_box"
                             t-att-style="cropStyles.cropBox"
                             t-on-pointerdown="onCropBoxPointerDown">
                            <div class="o_scn_grid"/>
                            <div class="o_scn_corner o_scn_corner_tl"/>
                            <div class="o_scn_corner o_scn_corner_tr"/>
                            <div class="o_scn_corner o_scn_corner_bl"/>
                            <div class="o_scn_corner o_scn_corner_br"/>
                            <t t-foreach="cropHandles" t-as="handle" t-key="handle.id">
                                <div class="o_scn_handle"
                                     t-att-style="getHandleStyle(handle)"
                                     t-on-pointerdown="(ev) => onCropHandlePointerDown(ev, handle.id)"/>
                            </t>
                        </div>
                    </t>
                </div>
            </div>

            <div class="o_scn_bar o_scn_bar_bottom d-flex flex-wrap align-items-center gap-2 p-3">
                <button type="button" class="btn btn-success"
                        t-att-disabled="state.cropBusy or !state.cropReady"
                        t-on-click="onApplyCrop">
                    <i t-attf-class="fa {{ state.cropBusy ? 'fa-spinner fa-spin' : 'fa-check' }} me-1"/>Apply Crop
                </button>
                <button type="button" class="btn btn-outline-light btn-sm"
                        t-att-disabled="state.cropBusy"
                        t-on-click="onUseFullImage">
                    <i class="fa fa-expand me-1"/>Use Full Image
                </button>
                <button type="button" class="btn btn-outline-info btn-sm"
                        title="Detect the document edges (works on white and black scanner backgrounds)"
                        t-att-disabled="state.cropBusy or !state.cropReady"
                        t-on-click="onAutoDetect">
                    <i class="fa fa-magic me-1"/>Auto-detect
                </button>
                <div class="d-flex gap-1 ms-2 ps-2 o_scn_sep">
                    <button type="button" class="btn btn-sm o_scn_btn_dark"
                            title="Rotate 90° counter-clockwise"
                            t-att-disabled="state.cropBusy"
                            t-on-click="onRotateLeft">
                        <i class="fa fa-rotate-left me-1"/>Rotate Left
                    </button>
                    <button type="button" class="btn btn-sm o_scn_btn_dark"
                            title="Rotate 90° clockwise"
                            t-att-disabled="state.cropBusy"
                            t-on-click="onRotateRight">
                        <i class="fa fa-rotate-right me-1"/>Rotate Right
                    </button>
                </div>
                <button type="button" class="btn btn-outline-danger btn-sm ms-auto"
                        t-att-disabled="state.cropBusy"
                        t-on-click="onCancelCrop">
                    <i class="fa fa-times me-1"/>Discard
                </button>
            </div>
        </div>
    </t>

    <t t-name="scanner_integration.BridgeStatus">
        <span class="ms-auto d-flex align-items-center gap-1">
            <i t-attf-class="fa fa-circle small {{ state.bridgeStatus === 'connected' ? 'text-success' : state.bridgeStatus === 'disconnected' ? 'text-danger' : 'text-muted' }}"/>
            <small class="text-muted">
                Bridge
                <t t-if="state.bridgeStatus === 'connected'">ready</t>
                <t t-elif="state.bridgeStatus === 'disconnected'">offline</t>
                <t t-else="">…</t>
            </small>
            <button t-if="state.bridgeStatus === 'disconnected'"
                    type="button" class="btn btn-link btn-sm p-0 ms-1"
                    title="Retry connection" t-on-click="onRetryBridge">
                <i class="fa fa-refresh"/>
            </button>
        </span>
    </t>

    <t t-name="scanner_integration.Messages">
        <!-- Scanner issue (double feed, jam, cover open…) -->
        <div t-if="state.scanIssue"
             t-attf-class="alert {{ state.scanIssue.level === 'danger' ? 'alert-danger' : 'alert-warning' }} py-2 px-3 mb-0 small o_scn_issue">
            <div class="d-flex gap-2">
                <i t-attf-class="fa {{ state.scanIssue.icon }} fa-2x mt-1"/>
                <div class="flex-grow-1">
                    <div class="fw-bold"><t t-esc="state.scanIssue.title"/></div>
                    <div class="o_scn_prewrap"><t t-esc="state.scanIssue.body"/></div>
                    <div t-if="state.scanIssue.pagesDone" class="mt-1">
                        <i class="fa fa-check text-success me-1"/>
                        <t t-esc="state.scanIssue.pagesDone"/> page(s) received before the stop were kept.
                    </div>
                    <small t-if="state.scanIssue.detail" class="text-muted d-block mt-1 o_scn_prewrap">
                        <t t-esc="state.scanIssue.detail"/>
                    </small>
                    <div class="d-flex gap-2 mt-2">
                        <button t-if="state.scanIssue.resumable" type="button" class="btn btn-sm btn-primary"
                                t-att-disabled="isBusy" t-on-click="onResumeScan">
                            <i class="fa fa-play me-1"/><t t-esc="state.scanIssue.resumeLabel"/>
                        </button>
                        <button type="button" class="btn btn-sm btn-outline-secondary" t-on-click="onDismissIssue">
                            Dismiss
                        </button>
                    </div>
                </div>
            </div>
        </div>

        <div t-if="showStatusAlert"
             class="alert alert-success py-1 px-2 mb-0 small d-flex align-items-center gap-1">
            <i class="fa fa-check-circle"/>
            <t t-esc="state.statusMsg"/>
        </div>
        <div t-if="state.errorMsg" class="alert alert-danger py-1 px-2 mb-0 small d-flex gap-2">
            <i class="fa fa-exclamation-triangle mt-1"/>
            <div class="flex-grow-1">
                <span class="o_scn_prewrap" t-esc="state.errorMsg"/>
                <t t-if="state.bridgeStatus === 'disconnected'">
                    <br/>
                    <small class="text-muted">Run <code>python scanner_bridge.py</code> on this workstation.</small>
                </t>
            </div>
            <button type="button" class="btn-close btn-sm" title="Dismiss" t-on-click="onDismissError"/>
        </div>
    </t>


<!-- ═══════════════════════════════════════════════════════════════════════
     1.  CHEQUE IMAGE WIDGET
════════════════════════════════════════════════════════════════════════ -->
    <t t-name="scanner_integration.ScannerImageField">
        <div class="o_scanner_field o_scanner_image_field d-flex flex-column gap-2">

            <t t-if="state.showCropper">
                <t t-call="scanner_integration.CropEditor">
                    <t t-set="chequeMode" t-value="true"/>
                </t>
            </t>
            <t t-else="">
                <div class="border rounded overflow-hidden bg-light d-flex align-items-center justify-content-center o_scn_preview_box">
                    <t t-set="src" t-value="imageSrc"/>
                    <img t-if="src" t-att-src="src" class="img-fluid o_scn_preview_img" alt="Cheque image"/>
                    <div t-else="" class="text-center text-muted p-4">
                        <i class="fa fa-image fa-3x mb-2 d-block"/>
                        <small>No cheque image</small>
                    </div>
                </div>
            </t>

            <t t-if="!isReadonly and !state.showCropper">
                <div class="d-flex flex-wrap align-items-center gap-2">
                    <button type="button" class="btn btn-primary btn-sm"
                            t-att-disabled="isBusy" t-on-click="onScanClick">
                        <t t-if="state.scanning">
                            <span class="spinner-border spinner-border-sm me-1" role="status" aria-hidden="true"/>
                            <t t-esc="state.statusMsg or 'Scanning…'"/>
                        </t>
                        <t t-else=""><i class="fa fa-print me-1"/>Scan from Scanner</t>
                    </button>
                    <button type="button" class="btn btn-secondary btn-sm"
                            t-att-disabled="isBusy" t-on-click="onUploadClick">
                        <i class="fa fa-upload me-1"/>Upload Image
                    </button>
                    <button t-if="hasValue" type="button" class="btn btn-outline-danger btn-sm"
                            t-att-disabled="isBusy" t-on-click="onClearClick">
                        <i class="fa fa-trash me-1"/>Clear
                    </button>
                    <t t-call="scanner_integration.BridgeStatus"/>
                </div>
                <input type="file" t-ref="fileInput" accept="image/*" class="d-none" t-on-change="onFileChange"/>
                <t t-call="scanner_integration.Messages"/>
            </t>
        </div>
    </t>


<!-- ═══════════════════════════════════════════════════════════════════════
     2.  PDF DOCUMENT SCANNER WIDGET
════════════════════════════════════════════════════════════════════════ -->
    <t t-name="scanner_integration.ScannerPdfField">
        <div class="o_scanner_field o_scanner_pdf_field d-flex flex-column gap-2">

            <t t-if="state.showCropper">
                <t t-call="scanner_integration.CropEditor">
                    <t t-set="chequeMode" t-value="false"/>
                </t>
            </t>

            <t t-else="">
                <t t-set="attachments" t-value="currentAttachments"/>

                <!-- Saved documents -->
                <div t-if="attachments.length" class="border rounded overflow-hidden o_scn_dark o_scn_border">
                    <div class="o_scn_bar o_scn_bar_top d-flex align-items-center px-3 py-2">
                        <i class="fa fa-paperclip me-2 o_scn_accent"/>
                        <span class="fw-semibold small">
                            <t t-esc="attachments.length"/>
                            <t t-if="attachments.length === 1"> saved document</t>
                            <t t-else=""> saved documents</t>
                        </span>
                    </div>
                    <div class="d-flex flex-column gap-1 p-3">
                        <t t-foreach="attachments" t-as="att" t-key="att.id">
                            <div class="o_scn_att_row d-flex align-items-center gap-2">
                                <i t-attf-class="fa fa-lg {{ att.iconClass }}"/>
                                <span class="o_scn_att_idx font-monospace"><t t-esc="att_index + 1"/></span>
                                <span class="o_scn_att_name" t-att-title="att.name"><t t-esc="att.name"/></span>
                                <span class="o_scn_att_date font-monospace" title="Upload date"><t t-esc="att.dateLabel"/></span>
                                <button t-if="att.canPreview" type="button" title="Preview"
                                        class="o_scn_icon_btn o_scn_icon_preview"
                                        t-on-click="() => onPreviewAttachment(att)">
                                    <i class="fa fa-eye"/>
                                </button>
                                <a t-attf-href="/web/content/{{ att.id }}?download=true"
                                   title="Download" class="o_scn_icon_btn o_scn_icon_download">
                                    <i class="fa fa-download"/>
                                </a>
                                <button t-if="!isReadonly" type="button" title="Remove from record"
                                        class="o_scn_icon_btn o_scn_icon_remove"
                                        t-att-disabled="isBusy"
                                        t-on-click="() => onRemoveAttachment(att.id)">
                                    <i class="fa fa-times"/>
                                </button>
                            </div>
                        </t>
                    </div>
                </div>

                <!-- Pending pages -->
                <div t-if="state.pages.length" class="border rounded overflow-hidden o_scn_dark o_scn_border">
                    <div class="o_scn_bar o_scn_bar_top d-flex align-items-center px-3 py-2">
                        <i class="fa fa-files-o me-2 o_scn_accent"/>
                        <span class="fw-semibold small">
                            <t t-esc="state.pages.length"/>
                            <t t-if="state.pages.length === 1"> page</t>
                            <t t-else=""> pages</t>
                            <t t-if="state.scanning and state.scanSource === 'adf'"> — receiving…</t>
                            <t t-else=""> — ready to save as PDF</t>
                        </span>
                        <small class="ms-auto o_scn_muted">Click a thumbnail to crop</small>
                    </div>
                    <div class="d-flex flex-wrap gap-3 p-3 o_scn_pages">
                        <t t-foreach="state.pages" t-as="page" t-key="page.id">
                            <div class="d-flex flex-column gap-1 o_scn_page">
                                <div class="o_scn_thumb position-relative border rounded overflow-hidden"
                                     title="Click to crop this page"
                                     t-on-click="() => onCropPage(page_index)">
                                    <img t-if="page.thumb"
                                         t-att-src="'data:image/jpeg;base64,' + page.thumb"
                                         class="w-100 h-100 o_scn_contain"
                                         t-att-alt="'Page ' + (page_index + 1)"/>
                                    <div t-else="" class="w-100 h-100 d-flex align-items-center justify-content-center text-white-50">
                                        <i class="fa fa-file-image-o fa-2x"/>
                                    </div>
                                    <div class="o_scn_page_no position-absolute top-0 start-0 m-1 px-1 rounded font-monospace">
                                        <t t-esc="page_index + 1"/>
                                    </div>
                                    <div class="o_scn_thumb_hover position-absolute top-0 start-0 w-100 h-100 d-flex align-items-center justify-content-center">
                                        <i class="fa fa-crop fa-lg text-white"/>
                                    </div>
                                </div>
                                <div class="d-flex gap-1">
                                    <button type="button" class="btn p-0 flex-grow-1 o_scn_page_btn" title="Move left"
                                            t-att-disabled="page_index === 0 or isBusy"
                                            t-on-click.stop="() => onMovePage(page_index, -1)">&#9664;</button>
                                    <button type="button" class="btn p-0 flex-grow-1 o_scn_page_btn o_scn_page_btn_danger"
                                            title="Remove page" t-att-disabled="isBusy"
                                            t-on-click.stop="() => onRemovePage(page_index)">&#x2715;</button>
                                    <button type="button" class="btn p-0 flex-grow-1 o_scn_page_btn" title="Move right"
                                            t-att-disabled="page_index === state.pages.length - 1 or isBusy"
                                            t-on-click.stop="() => onMovePage(page_index, 1)">&#9654;</button>
                                </div>
                            </div>
                        </t>
                    </div>
                </div>

                <!-- Empty state -->
                <div t-if="!state.pages.length and !attachments.length"
                     class="border rounded d-flex align-items-center justify-content-center o_scn_empty">
                    <div class="text-center text-muted p-4">
                        <i class="fa fa-file-pdf-o fa-3x mb-2 d-block o_scn_empty_icon"/>
                        <small>No document yet — scan pages, upload images to build a PDF, or upload a file directly</small>
                    </div>
                </div>
            </t>

            <!-- Toolbar -->
            <t t-if="!isReadonly and !state.showCropper">
                <div class="d-flex flex-wrap align-items-center gap-2">
                    <button type="button" class="btn btn-primary btn-sm"
                            t-att-disabled="isBusy" t-on-click="onScanFlatbed">
                        <t t-if="state.scanning and state.scanSource === 'flatbed'">
                            <span class="spinner-border spinner-border-sm me-1" role="status"/>
                            <t t-esc="state.statusMsg or 'Scanning…'"/>
                        </t>
                        <t t-else=""><i class="fa fa-print me-1"/>Add Page</t>
                    </button>

                    <button type="button" class="btn btn-sm text-white o_scn_btn_adf"
                            t-att-disabled="isBusy" t-on-click="onScanAdf">
                        <t t-if="state.scanning and state.scanSource === 'adf'">
                            <span class="spinner-border spinner-border-sm me-1" role="status"/>
                            <t t-esc="state.statusMsg or 'Scanning feeder…'"/>
                            <span t-if="state.adfReceived" class="badge bg-light text-dark ms-1">
                                <t t-esc="state.adfReceived"/>
                            </span>
                        </t>
                        <t t-else=""><i class="fa fa-copy me-1"/>Scan All (ADF)</t>
                    </button>

                    <button t-if="state.scanning and state.scanSource === 'adf'"
                            type="button" class="btn btn-outline-danger btn-sm"
                            title="Stop the feeder after the current page"
                            t-att-disabled="!state.scanJobId or state.stopRequested"
                            t-on-click="onStopScan">
                        <i class="fa fa-stop me-1"/>Stop
                    </button>

                    <button type="button" class="btn btn-secondary btn-sm"
                            t-att-disabled="isBusy" t-on-click="onUploadClick">
                        <t t-if="state.importing">
                            <span class="spinner-border spinner-border-sm me-1" role="status"/>Adding…
                        </t>
                        <t t-else=""><i class="fa fa-upload me-1"/>Images</t>
                    </button>

                    <button type="button" class="btn btn-sm text-white o_scn_btn_upload"
                            t-att-disabled="isBusy" t-on-click="onDirectUploadClick">
                        <t t-if="state.uploading">
                            <span class="spinner-border spinner-border-sm me-1" role="status"/>
                            <t t-esc="state.statusMsg or 'Uploading…'"/>
                        </t>
                        <t t-else=""><i class="fa fa-file-o me-1"/>Upload File</t>
                    </button>

                    <t t-if="state.pages.length">
                        <button type="button" class="btn btn-success btn-sm"
                                t-att-disabled="isBusy" t-on-click="onSavePdf">
                            <t t-if="state.saving">
                                <span class="spinner-border spinner-border-sm me-1" role="status"/>Saving…
                            </t>
                            <t t-else="">
                                <i class="fa fa-file-pdf-o me-1"/>Save as PDF
                                <span class="badge bg-light text-success ms-1"><t t-esc="state.pages.length"/>p</span>
                            </t>
                        </button>
                        <button type="button" class="btn btn-outline-danger btn-sm"
                                t-att-disabled="isBusy" t-on-click="onClearPages">
                            <i class="fa fa-trash me-1"/>Clear
                        </button>
                    </t>

                    <t t-call="scanner_integration.BridgeStatus"/>
                </div>

                <input type="file" t-ref="fileInput" accept="image/*" multiple="multiple"
                       class="d-none" t-on-change="onFileChange"/>
                <input type="file" t-ref="fileDirect" multiple="multiple"
                       class="d-none" t-on-change="onDirectFileChange"/>

                <t t-call="scanner_integration.Messages"/>
            </t>

            <!-- Preview modal -->
            <t t-if="state.showPreview and previewUrl">
                <div class="o_scn_preview_backdrop" t-on-click="onClosePreview">
                    <div class="o_scn_preview_panel" t-on-click="onPreviewPanelClick">
                        <div class="o_scn_preview_header">
                            <i t-attf-class="fa {{ previewIsPdf ? 'fa-file-pdf-o' : 'fa-file-image-o' }} o_scn_preview_icon"/>
                            <span class="o_scn_preview_title" t-esc="state.previewFilename"/>
                            <a t-att-href="previewUrl" target="_blank" rel="noopener" title="Open in new tab" class="o_scn_preview_action">
                                <i class="fa fa-external-link"/>
                            </a>
                            <a t-att-href="downloadUrl" title="Download" class="o_scn_preview_action">
                                <i class="fa fa-download"/>
                            </a>
                            <button type="button" title="Close preview" class="o_scn_preview_close" t-on-click="onClosePreview">
                                <i class="fa fa-times"/>
                            </button>
                        </div>
                        <div class="o_scn_preview_body">
                            <img t-if="!previewIsPdf" t-att-src="previewUrl" class="o_scn_preview_image" alt="Preview"/>
                            <iframe t-else="" t-att-src="previewUrl" class="o_scn_preview_frame" title="PDF Preview"/>
                        </div>
                        <div class="o_scn_preview_footer">
                            <small><i class="fa fa-info-circle me-1"/>Click outside the panel, press Esc or &#x2715; to close</small>
                            <small>Viewer provided by your browser</small>
                        </div>
                    </div>
                </div>
            </t>
<!-- Scanner picker -->
            <t t-if="state.showScannerDialog">
                <div class="o_scn_modal_backdrop" t-on-click="onScannerCancel"/>
                <div class="o_scn_modal o_scn_picker">
                    <h5 class="mb-3 fw-semibold d-flex align-items-center">
                        <i class="fa fa-print me-2 text-primary"/>
                        <t t-if="state.pendingScanAction === 'adf'">Scan All — Select Scanner</t>
                        <t t-else="">Add Page — Select Scanner</t>
                        <button type="button" class="btn btn-link btn-sm ms-auto" title="Search again"
                                t-att-disabled="state.loadingScanners" t-on-click="onRefreshScanners">
                            <i t-attf-class="fa fa-refresh {{ state.loadingScanners ? 'fa-spin' : '' }}"/>
                        </button>
                    </h5>

                    <!-- ADF options -->
                    <div t-if="state.pendingScanAction === 'adf'" class="o_scn_options border rounded p-2 mb-3">
                        <div class="row g-2">
                            <div class="col-sm-6">
                                <label class="form-check form-switch mb-0">
                                    <input class="form-check-input" type="checkbox" t-model="state.adfOptions.duplex"/>
                                    <span class="form-check-label">Duplex (both sides)</span>
                                </label>
                            </div>
                            <div class="col-sm-6">
                                <label class="form-check form-switch mb-0">
                                    <input class="form-check-input" type="checkbox" t-model="state.adfOptions.doubleFeed"/>
                                    <span class="form-check-label">Double-feed detection</span>
                                </label>
                            </div>
                            <div class="col-sm-6">
                                <label class="form-check form-switch mb-0">
                                    <input class="form-check-input" type="checkbox" t-model="state.adfOptions.skipBlank"/>
                                    <span class="form-check-label">Remove blank pages</span>
                                </label>
                            </div>
                            <div class="col-sm-6" t-if="state.adfOptions.skipBlank">
                                <select class="form-select form-select-sm" t-model="state.adfOptions.blankSensitivity">
                                    <option value="low">Sensitivity: low (keep more)</option>
                                    <option value="normal">Sensitivity: normal</option>
                                    <option value="high">Sensitivity: high (remove more)</option>
                                </select>
                            </div>
                            <div class="col-12">
                                <label class="form-check form-switch mb-0">
                                    <input class="form-check-input" type="checkbox" t-model="state.adfOptions.imprintEnabled"/>
                                    <span class="form-check-label">Imprint / endorse pages</span>
                                </label>
                            </div>
                            <t t-if="state.adfOptions.imprintEnabled">
                                <div class="col-sm-7">
                                    <input type="text" class="form-control form-control-sm"
                                           placeholder="{date} ODOO {counter}"
                                           title="Imprint text"
                                           t-model="state.adfOptions.imprintText"/>
                                </div>
                                <div class="col-sm-3">
                                    <input type="number" min="0" class="form-control form-control-sm"
                                           title="Counter start" t-model.number="state.adfOptions.imprintStart"/>
                                </div>
                                <div class="col-sm-2">
                                    <input type="number" min="1" max="8" class="form-control form-control-sm"
                                           title="Counter digits" t-model.number="state.adfOptions.imprintDigits"/>
                                </div>
                                <div class="col-sm-6">
                                    <select class="form-select form-select-sm" t-model="state.adfOptions.imprintMode">
                                        <option value="auto">Scanner imprinter, else digital stamp</option>
                                        <option value="hardware">Scanner imprinter only</option>
                                        <option value="digital">Digital stamp only</option>
                                    </select>
                                </div>
                                <div class="col-sm-6">
                                    <select class="form-select form-select-sm" t-model="state.adfOptions.imprintPosition">
                                        <option value="top">Digital stamp: top right</option>
                                        <option value="bottom">Digital stamp: bottom right</option>
                                    </select>
                                </div>
                                <div class="col-12">
                                    <small class="text-muted">
                                        Placeholders: <code>{counter}</code> <code>{date}</code> — preview:
                                        <span class="font-monospace text-danger" t-esc="imprintPreview"/>
                                    </small>
                                </div>
                            </t>
                        </div>
                    </div>

                    <div class="list-group mb-3 o_scn_scanner_list">
                        <button type="button"
                                class="list-group-item list-group-item-action d-flex align-items-center gap-2"
                                t-on-click="() => onScannerConfirm(null)">
                            <i class="fa fa-star text-warning"/>
                            <div>
                                <div class="fw-semibold">Default Scanner</div>
                                <small class="text-muted">Use the first available device</small>
                            </div>
                        </button>

                        <div t-if="state.loadingScanners" class="list-group-item d-flex align-items-center gap-2 text-muted">
                            <i class="fa fa-spinner fa-spin"/>
                            <span>Detecting available scanners… (this can take up to a minute)</span>
                        </div>

                        <t t-foreach="state.availableScanners" t-as="scanner" t-key="scanner_index">
                            <button type="button"
                                    class="list-group-item list-group-item-action d-flex align-items-center gap-2"
                                    t-on-click="() => onScannerConfirm(scanner)">
                                <i t-attf-class="fa {{ scanner.source === 'inbox' ? 'fa-folder-open text-info' : scanner.ready === false ? 'fa-print text-muted' : 'fa-print text-secondary' }}"/>
                                <div class="text-truncate">
                                    <div class="fw-semibold text-truncate">
                                        <t t-esc="scanner.display or scanner.name"/>
                                        <span t-if="scanner.source === 'inbox'" class="badge text-bg-info ms-1">inbox</span>
                                        <span t-elif="scanner.ready === false" class="badge text-bg-warning ms-1">unverified</span>
                                    </div>
                                    <small class="text-muted font-monospace d-block text-truncate" t-att-title="scanner.name">
                                        <t t-esc="scanner.name"/>
                                    </small>
                                    <small t-if="scanner.note" class="text-muted fst-italic d-block text-wrap">
                                        <t t-esc="scanner.note"/>
                                    </small>
                                </div>
                            </button>
                        </t>

                        <div t-if="!state.loadingScanners and !state.availableScanners.length and !state.scannerListError"
                             class="list-group-item text-muted fst-italic">
                            <i class="fa fa-info-circle me-1"/>No additional scanners detected — Default will be used.
                        </div>
                        <div t-if="state.scannerListError" class="list-group-item text-danger small">
                            <i class="fa fa-exclamation-triangle me-1"/><t t-esc="state.scannerListError"/>
                        </div>
                    </div>

                    <div class="d-flex justify-content-end">
                        <button type="button" class="btn btn-secondary" t-on-click="onScannerCancel">Cancel</button>
                    </div>
                </div>
            </t>

            <!-- Filename dialog -->
            <t t-if="state.showFilenameDialog">
                <div class="o_scn_modal_backdrop" t-on-click="onFilenameCancel"/>
                <div class="o_scn_modal o_scn_filename_dialog">
                    <h5 class="mb-3 fw-semibold">
                        <i class="fa fa-file-pdf-o me-2 text-danger"/>Save as PDF
                    </h5>
                    <label class="form-label">File name</label>
                    <div class="input-group mb-1">
                        <input type="text"
                               class="form-control"
                               t-ref="filenameInput"
                               t-model="state.pendingFilename"
                               t-on-keydown="onFilenameKeydown"
                               placeholder="e.g. Invoice_2024"/>
                        <span class="input-group-text text-muted">.pdf</span>
                    </div>
                    <div class="form-text text-muted mb-4">
                        The <code>.pdf</code> extension is added automatically.
                    </div>
                    <div class="d-flex gap-2 justify-content-end">
                        <button type="button" class="btn btn-secondary" t-on-click="onFilenameCancel">Cancel</button>
                        <button type="button" class="btn btn-success"
                                t-att-disabled="!state.pendingFilename.trim()"
                                t-on-click="onFilenameConfirm">
                            <i class="fa fa-save me-1"/>Save PDF
                        </button>
                    </div>
                </div>
            </t>

        </div>
    </t>

</templates>